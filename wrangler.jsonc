{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "donate-17bytes",
  "main": "src/index.js",
  "compatibility_date": "2026-09-23",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  }

  // Do NOT put RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET here as plain "vars" —
  // keep the secret out of source control. Set both in:
  //   Cloudflare dashboard -> Workers & Pages -> this Worker -> Settings
  //   -> Variables and Secrets
  // or via the CLI:
  //   wrangler secret put RAZORPAY_KEY_SECRET
  //   wrangler deploy --var RAZORPAY_KEY_ID:your_key_id   (or also as a secret)
}
